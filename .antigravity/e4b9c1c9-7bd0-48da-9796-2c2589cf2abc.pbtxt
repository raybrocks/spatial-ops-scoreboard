\\n      <div class=\\\"space-y-2\\\">\\n        <div class=\\\"p-3 bg-cyan-900/20 border border-cyan-500/30 rounded flex justify-between items-center\\\">\\n          <div>\\n            <div class=\\\"text-sm font-medium text-white\\\">Today, April 20</div>\\n            <div class=\\\"text-[10px] text-cyan-300\\\">4 Matches Found</div>\\n          </div>\\n          <div class=\\\"h-2 w-2 rounded-full bg-cyan-400\\\"></div>\\n        </div>\\n        <div class=\\\"p-3 bg-white/5 border border-white/5 rounded flex justify-between items-center opacity-60 hover:opacity-100 cursor-pointer\\\">\\n          <div>\\n            <div class=\\\"text-sm font-medium\\\">Yesterday, April 19</div>\\n            <div class=\\\"text-[10px] text-gray-400\\\">12 Matches</div>\\n          </div>\\n        </div>\\n        <div class=\\\"p-3 bg-white/5 border border-white/5 rounded flex justify-between items-center opacity-60 hover:opacity-100 cursor-pointer\\\">\\n          <div>\\n            <div class=\\\"text-sm font-medium\\\">Saturday, April 18</div>\\n            <div class=\\\"text-[10px] text-gray-400\\\">8 Matches</div>\\n          </div>\\n        </div>\\n      </div>\\n    </div>\\n\\n    <div class=\\\"mt-auto p-4 border-t border-white/10\\\">\\n      <button class=\\\"w-full bg-cyan-600 hover:bg-cyan-500 text-white py-3 rounded-md font-bold text-sm mb-3 shadow-lg shadow-cyan-900/20\\\">\\n        + IMPORT JSON MATCH\\n      </button>\\n      <button class=\\\"w-full bg-white/5 hover:bg-white/10 text-white border border-white/10 py-2 rounded-md text-xs uppercase tracking-widest\\\">\\n        Print Selected (0)\\n      </button>\\n    </div>\\n  </div>\\n\\n  <!-- Main Content: Match Details -->\\n  <div class=\\\"flex-1 flex flex-col\\\">\\n    <!-- Top Bar -->\\n    <div class=\\\"h-16 border-b border-white/10 flex items-center justify-between px-8 bg-[#0D0D0D]\\\">\\n      <div class=\\\"flex items-center gap-4 text-sm\\\">\\n        <span class=\\\"text-gray-500