    replacement_infos {
      original_chunk {
        target_content: "function TeamTable({ teamName, stats, color }: { teamName: string, stats: PlayerStat[], color: \'blue\' | \'red\' }) {\n  const sortedStats = [...stats].sort((a, b) => b.score - a.score);\n  \n  const headerColor = color === \'blue\' ? \'bg-blue-100 text-blue-900 border-blue-200\' : \'bg-red-100 text-red-900 border-red-200\';\n  const badgeColor = color === \'blue\' ? \'bg-blue-600\' : \'bg-red-600\';\n\n  return (\n    <div className=\"bg-white rounded-lg border border-slate-200 overflow-hidden shadow-sm\">\n      <div className={`px-4 py-3 border-b font-bold uppercase tracking-wider flex justify-between items-center ${headerColor}`}>\n        <span>{teamName}</span>\n      </div>\n      <div className=\"overflow-x-auto\">\n        <table className=\"w-full text-sm text-left\">\n          <thead className=\"text-xs text-slate-500 uppercase bg-slate-50 border-b border-slate-100\">\n            <tr>\n              <th className=\"px-4 py-3 font-semibold\">Player</th>\n              <th className=\"px-3 py-3 font-semibold text-center\" title=\"Score\">Score</th>\n              <th className=\"px-3 py-3 font-semibold text-center\" title=\"Kills\"><Crosshair className=\"w-4 h-4 mx-auto\" /></th>\n              <th className=\"px-3 py-3 font-semibold text-center\" title=\"Deaths\"><Skull className=\"w-4 h-4 mx-auto\" /></th>\n              <th className=\"px-3 py-3 font-semibold text-center\" title=\"Assists\">AST</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-slate-100\">\n            {sortedStats.length === 0 ? (\n              <tr>\n                <td colSpan={5} className=\"px-4 py-4 text-center text-slate-400 italic\">No players recorded</td>\n              </tr>\n            ) : (\n              sortedStats.map((player, idx) => (\n                <tr key={idx} className=\"hover:bg-slate-50 transition-colors\">\n                  <td className=\"px-4 py-3 font-medium text-slate-900 flex items-center gap-2\">\n                    {player.playerName}\n                    {player.isBot && (\n                      <span className=\"text-[10px] uppercase font-bold bg-slate-200 text-slate-600 px-1.5 py-0.5 rounded\">Bot</span>\n                    )}\n                  </td>\n                  <td className=\"px-3 py-3 font-bold tabular-nums text-center\">{player.score}</td>\n                  <td className=\"px-3 py-3 tabular-nums text-center\">{player.kills}</td>\n                  <td className=\"px-3 py-3 tabular-nums text-center\">{player.deaths}</td>\n                  <td className=\"px-3 py-3 tabular-nums text-center\">{player.assists}</td>\n                </tr>\n              ))\n            )}\n          </tbody>\n        </table>\n      </div>\n    </div>\n  );\n}"
        replacement_content: "function TeamTable({ teamName, stats, color }: { teamName: string, stats: PlayerStat[], color: \'blue\' | \'red\' }) {\n  const sortedStats = [...stats].sort((a, b) => b.score - a.score);\n  \n  const textColor = color === \'blue\' ? \'text-blue-400\' : \'text-red-400\';\n  const rowHighlight = color === \'blue\' ? \'bg-blue-500/5\' : \'bg-red-500/5\';\n  const mvpBadge = color === \'blue\' ? \'bg-blue-500/20 text-blue-400\' : \'bg-red-500/20 text-red-400\';\n\n  return (\n    <div className=\"bg-white/5 border border-white/10 rounded-lg overflow-hidden\">\n      <div className=\"overflow-x-auto\">\n        <table className=\"w-full text-left border-collapse\">\n          <thead className=\"bg-white/5\">\n            <tr className=\"text-[10px] uppercase tracking-widest text-gray-500\">\n              <th className=\"py-3 px-4 font-bold\">Player</th>\n              <th className=\"py-3 px-2 font-bold text-center\" title=\"Score\">Score</th>\n              <th className=\"py-3 px-2 font-bold text-center\" title=\"Kills\">Kills</th>\n              <th className=\"py-3 px-2 font-bold text-center\" title=\"Deaths\">Deaths</th>\n              <th className=\"py-3 px-2 font-bold text-center\" title=\"Assists\">AST</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-white/5 text-sm\">\n            {sortedStats.length === 0 ? (\n              <tr>\n                <td colSpan={5} className=\"px-4 py-4 text-center text-gray-600 italic\">No players recorded</td>\n              </tr>\n            ) : (\n              sortedStats.map((player, idx) => {\n                const isMVP = idx === 0 && player.score > 0;\n                return (\n                  <tr key={idx} className={`hover:bg-white/[0.02] ${isMVP && !player.isBot ? rowHighlight : player.isBot ? \'opacity-70 italic\' : \'\'}`}>\n                    <td className=\"py-3 px-4 font-medium flex items-center flex-wrap gap-2 text-gray-300\">\n                      <span className={isMVP && !player.isBot ? \'font-bold text-white\' : \'\'}>{player.playerName}</span>\n                      {isMVP && !player.isBot && (\n                        <span className={`text-[8px] px-1 rounded uppercase tracking-wider font-bold ${mvpBadge}`}>MVP</span>\n                      )}\n                      {player.isBot && (\n                        <span className=\"text-[8px] border border-white/20 text-gray-500 px-1 rounded uppercase font-bold\">Bot</span>\n                      )}\n                    </td>\n                    <td className={`py-3 px-2 font-mono text-center ${textColor}`}>{player.score}</td>\n                    <td className=\"py-3 px-2 text-center text-gray-400\">{player.kills}</td>\n                    <td className=\"py-3 px-2 text-center text-gray-400\">{player.deaths}</td>\n                    <td className=\"py-3 px-2 text-center text-gray-400\">{player.assists}</td>\n                  </tr>\n                );\n              })\n            )}\n          </tbody>\n        </table>\n      </div>\n    </div>\n  );\n}"
      }
      num_matches: 1
    }
  }
}
